# Copy this file to terraform.tfvars (which is gitignored) and adjust.
# Every value has a default in variables.tf, so an empty file also works.

project_name      = "modern-web"
aws_region        = "eu-central-1"
github_owner      = "saschwan"
github_repository = "modern_web_deployment"

# Set to false if IAM already has an identity provider for token.actions.githubusercontent.com.
create_github_oidc_provider = true

# Requires GitHub Pro for private repositories.
enable_branch_protection = true

